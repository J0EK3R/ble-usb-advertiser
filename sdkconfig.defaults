# All non-default Kconfig options of the firmware (sdkconfig itself is not committed).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Bluetooth: NimBLE host, BLE 5 extended advertising API used with legacy PDUs only.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=y
# 4 additional instances + 1 mandatory = 5 simultaneous advertising sets.
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=4
# Only legacy (31 byte) data is ever used, keep the extended buffers small.
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=64
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV=n
# Links: the controller shares CONFIG_BT_CTRL_BLE_MAX_ACT activities between the 5 advertising sets,
# the scan and the connections: 10 (the maximum of the ESP32-S3) - 5 - 1 = 4 links. NimBLE needs
# the same number of connection slots. BC2ADV_MAX_CONNS (main/Kconfig.projbuild) announces it.
CONFIG_BT_CTRL_BLE_MAX_ACT=10
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
# Broadcaster + peripheral (peripheral is required for connectable ADV_IND) + central + observer
# (scanner and GATT client, protocol 1.1).
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# A connect attempt may start while the scan runs (otherwise the adapter pauses the scan itself).
CONFIG_BT_NIMBLE_HOST_ALLOW_CONNECT_WITH_SCAN=y
# MTU the stick requests after every connect (BuWizz 3 writes 38 bytes, protocol values are <= 56).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=64
# Buffers for notification bursts of several links.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n

# The USB Serial/JTAG port carries only protocol frames: no console, no logs.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# Task watchdog: USB and core tasks subscribe, a hang resets the chip (= silence).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
